(* ::Package:: *)

(* ::Title:: *)
(*Poisson Brackets*)
(*  Definition, intuition, algebra, mechanics, geometry and manifolds \[LongDash] every claim checked.*)
(*  Companion to LaplacianBrackets.wl (\[CapitalGamma] is the symmetric twin of { , }).*)
(*  \[Copyright] 2026 Computational Classnotes \[CenterDot] CC BY-NC-SA 4.0*)

(* ::Text:: *)
(* Run the whole file in a fresh kernel. The last line shows the table `checks`;*)
(* every entry should be True. Note: the Poisson tensor is called \[CapitalPi] (capital),*)
(* because lower-case \[Pi] is the number Pi in Wolfram Language.*)

ClearAll["Global`*"];
checks = <||>;
check[name_String, test_] := (checks[name] = TrueQ[test]);
zeroQ[e_] := Simplify[e] === 0;
allZeroQ[e_] := Union[Flatten[{Simplify[e]}]] === {0};
grad[h_, v_List] := D[h, {v}];
\[Epsilon] = LeviCivitaTensor[3];


(* ::Section:: *)
(*1. Definition*)

(* ::Text:: *)
(* Canonical bracket on phase space (q_1..q_n, p_1..p_n):*)
(*      {f,g} = \[Sum]_i ( \[PartialD]f/\[PartialD]q_i \[PartialD]g/\[PartialD]p_i - \[PartialD]f/\[PartialD]p_i \[PartialD]g/\[PartialD]q_i ).*)
(* General Poisson manifold with coordinates v and an antisymmetric tensor \[CapitalPi]^{ij}(v):*)
(*      {f,g} = \[PartialD]_i f \[CapitalPi]^{ij} \[PartialD]_j g ,  provided Jacobi holds (Section 3).*)
(* Dynamics: every observable evolves by  df/dt = {f, H}.  With f = q_i, p_i*)
(* this is Hamilton's system  q' = \[PartialD]H/\[PartialD]p,  p' = -\[PartialD]H/\[PartialD]q.*)

PBq[f_, g_, qs_List, ps_List] := Expand@Sum[D[f, qs[[i]]] D[g, ps[[i]]] - D[f, ps[[i]]] D[g, qs[[i]]], {i, Length[qs]}];
PB\[CapitalPi][\[CapitalPi]_, v_List][f_, g_] := Expand[grad[f, v] . \[CapitalPi] . grad[g, v]];
Jcan[n_] := ArrayFlatten[{{0, IdentityMatrix[n]}, {-IdentityMatrix[n], 0}}];

qs = {q1, q2}; ps = {p1, p2}; z4 = Join[qs, ps];
pb[f_, g_] := PBq[f, g, qs, ps];
F = f @@ z4; G = g @@ z4; K = k @@ z4; Hg = H @@ z4;

check["1a  canonical bracket = \[CapitalPi]-bracket with \[CapitalPi] = J", zeroQ[pb[F, G] - PB\[CapitalPi][Jcan[2], z4][F, G]]];
check["1b  {q_i,H} = \[PartialD]H/\[PartialD]p_i, {p_i,H} = -\[PartialD]H/\[PartialD]q_i (Hamilton)",
  allZeroQ[{pb[#, Hg] & /@ qs - D[Hg, {ps}], pb[#, Hg] & /@ ps + D[Hg, {qs}]}]];


(* ::Section:: *)
(*2. Intuition*)

(* ::Text:: *)
(* (a) Area.  In one degree of freedom {f,g} = det \[PartialD](f,g)/\[PartialD](q,p): the factor by*)
(*     which the map (q,p) \[RightTeeArrow] (f,g) stretches oriented phase-space area.*)
(*     {f,g} = 1 means (f,g) are new canonical coordinates.*)
(* (b) Rate.  {f,g} is the rate of change of f along the flow generated by g:*)
(*     {f,H} = d/dt f(\[CurlyPhi]_t) at t = 0.  {f,g} = 0 \[DoubleLongLeftRightArrow] f is conserved by g's flow*)
(*     \[DoubleLongLeftRightArrow] g is conserved by f's flow (symmetries \[LeftRightArrow] conservation laws, Noether).*)
(* (c) Shadow of quantum mechanics.  The Moyal commutator (f\[Star]g - g\[Star]f)/(i\[HBar]) tends to*)
(*     {f,g} as \[HBar] \[RightArrow] 0; Dirac's rule {,} \[LongRightArrow] [,]/(i\[HBar]) runs this backwards.*)

pb1[f_, g_] := PBq[f, g, {q}, {p}];
check["2a  {f,g} = Jacobian determinant of (q,p) \[RightTeeArrow] (f,g)",
  zeroQ[pb1[f[q, p], g[q, p]] - Det[D[{f[q, p], g[q, p]}, {{q, p}}]]]];

(* harmonic oscillator: exact flow is a clockwise rotation of the (q,p) plane *)
Hosc = (q^2 + p^2)/2;
flow = {q Cos[t] + p Sin[t], -q Sin[t] + p Cos[t]};
check["2b  oscillator flow solves Hamilton's equations",
  allZeroQ[D[flow, t] - ({D[Hosc, p], -D[Hosc, q]} /. Thread[{q, p} -> flow])]];
check["2c  d/dt f(flow) at t=0 = {f,H}",
  zeroQ[(D[f @@ flow, t] /. t -> 0) - pb1[f[q, p], Hosc]]];
check["2d  flow preserves area (Jacobian = 1)", zeroQ[Det[D[flow, {{q, p}}]] - 1]];

(* Moyal star product in one degree of freedom (exact on polynomials when N \[GreaterEqual] degree) *)
star[f_, g_, N_ : 6] := Expand@Sum[(I \[HBar]/2)^n/n! Sum[Binomial[n, j] (-1)^j D[f, {q, n - j}, {p, j}] D[g, {p, n - j}, {q, j}], {j, 0, n}], {n, 0, N}];
mc[f_, g_] := Expand[(star[f, g] - star[g, f])/(I \[HBar])];
fP = q^3 p + 2 q p^2; gP = p^3 - q^2 p^2 + q;
check["2e  [q,p]_\[Star] = i\[HBar]", Expand[star[q, p] - star[p, q]] === I \[HBar]];
check["2f  Moyal bracket \[RightArrow] Poisson bracket as \[HBar] \[RightArrow] 0",
  zeroQ[(mc[fP, gP] /. \[HBar] -> 0) - pb1[fP, gP]] && ! zeroQ[mc[fP, gP] - pb1[fP, gP]]];
check["2g  quadratic H: Moyal bracket = Poisson bracket exactly",
  zeroQ[mc[fP, Hosc] - pb1[fP, Hosc]]];
check["2h  \[Star] is associative (noncommutative deformation)",
  zeroQ[star[star[q^2, p], q p^2] - star[q^2, star[p, q p^2]]]];


(* ::Section:: *)
(*3. Properties as an algebra*)

(* ::Text:: *)
(* A Poisson algebra = commutative algebra + Lie bracket that is a derivation:*)
(*   bilinear, antisymmetric, Jacobi {f,{g,k}} + {g,{k,f}} + {k,{f,g}} = 0,*)
(*   Leibniz {f, g k} = {f,g} k + g {f,k}.*)
(* Consequences checked below:*)
(*  \[Bullet] f \[RightTeeArrow] X_f (X_f h = {h,f}) is a Lie anti-homomorphism: [X_f, X_g] = -X_{f,g};*)
(*  \[Bullet] Poisson's theorem: {F,H} = {G,H} = 0  \[DoubleLongRightArrow]  {{F,G},H} = 0;*)
(*  \[Bullet] for \[CapitalPi]^{ij}(v), Jacobi \[DoubleLongLeftRightArrow] the Jacobiator (Schouten [\[CapitalPi],\[CapitalPi]]) vanishes;*)
(*  \[Bullet] in dimension 2 every bivector k(x,y) \[PartialD]x\[Wedge]\[PartialD]y is Poisson;*)
(*  \[Bullet] Casimirs C ({C, \[CenterDot]} = 0) exist exactly when \[CapitalPi] is degenerate.*)

check["3a  bilinear", zeroQ[pb[\[Alpha] F + \[Beta] K, G] - \[Alpha] pb[F, G] - \[Beta] pb[K, G]]];
check["3b  antisymmetric", zeroQ[pb[F, G] + pb[G, F]]];
check["3c  Jacobi", zeroQ[pb[F, pb[G, K]] + pb[G, pb[K, F]] + pb[K, pb[F, G]]]];
check["3d  Leibniz", zeroQ[pb[F, G K] - pb[F, G] K - G pb[F, K]]];
check["3e  canonical relations {q_i,q_j}=0, {p_i,p_j}=0, {q_i,p_j}=\[Delta]_ij",
  Outer[pb, qs, qs] === {{0, 0}, {0, 0}} && Outer[pb, ps, ps] === {{0, 0}, {0, 0}} && Outer[pb, qs, ps] === IdentityMatrix[2]];
check["3f  chain rule {\[CurlyPhi](f), g} = \[CurlyPhi]'(f){f,g}", zeroQ[pb[\[CurlyPhi][F], G] - \[CurlyPhi]'[F] pb[F, G]]];

X[f_][h_] := pb[h, f];
check["3g  [X_f, X_g] = -X_{f,g}", zeroQ[X[F][X[G][K]] - X[G][X[F][K]] + X[pb[F, G]][K]]];

(* Jacobiator J^{ijk} = \[CapitalPi]^{il}\[PartialD]_l\[CapitalPi]^{jk} + cyclic *)
jacobiator[\[CapitalPi]_, v_] := With[{n = Length[v]}, Table[Sum[\[CapitalPi][[i, l]] D[\[CapitalPi][[j, kk]], v[[l]]] + \[CapitalPi][[j, l]] D[\[CapitalPi][[kk, i]], v[[l]]] + \[CapitalPi][[kk, l]] D[\[CapitalPi][[i, j]], v[[l]]], {l, n}], {i, n}, {j, n}, {kk, n}]];
v3 = {x, y, z};
\[CapitalPi]bad = {{0, y, 0}, {-y, 0, x}, {0, -x, 0}};
check["3h  an antisymmetric \[CapitalPi] that is NOT Poisson: Jacobiator \[NotEqual] 0 ...", ! allZeroQ[jacobiator[\[CapitalPi]bad, v3]]];
check["3i  ... and Jacobi indeed fails for its bracket",
  ! zeroQ[PB\[CapitalPi][\[CapitalPi]bad, v3][x, PB\[CapitalPi][\[CapitalPi]bad, v3][y, z]] + PB\[CapitalPi][\[CapitalPi]bad, v3][y, PB\[CapitalPi][\[CapitalPi]bad, v3][z, x]] + PB\[CapitalPi][\[CapitalPi]bad, v3][z, PB\[CapitalPi][\[CapitalPi]bad, v3][x, y]]]];
check["3j  every 2D bivector is Poisson", allZeroQ[jacobiator[{{0, \[Kappa][x, y]}, {-\[Kappa][x, y], 0}}, {x, y}]]];


(* ::Section:: *)
(*4. Lie\[Dash]Poisson brackets: so(3)*, Casimirs, the rigid body*)

(* ::Text:: *)
(* On the dual of a Lie algebra, {f,g}(m) = \[LeftAngleBracket] m, [df, dg] \[RightAngleBracket].  For so(3)* = R^3:*)
(*      {f,g}_\[PlusMinus](m) = \[PlusMinus] m \[CenterDot] (\[Del]f \[Times] \[Del]g),   \[CapitalPi]^{ij} = \[PlusMinus]\[Epsilon]_{ijk} m_k.*)
(* It is degenerate: C = |m|^2 is a Casimir, so motion stays on spheres |m| = R*)
(* (coadjoint orbits = symplectic leaves).  The free rigid body is*)
(* H = \[Sum] m_i^2/(2 I_i) with the minus bracket (body frame) and gives Euler's equations.*)

m = {m1, m2, m3};
\[CapitalPi]LP = Table[Sum[\[Epsilon][[i, j, kk]] m[[kk]], {kk, 3}], {i, 3}, {j, 3}];
lp = PB\[CapitalPi][\[CapitalPi]LP, m];
check["4a  Lie\[Dash]Poisson \[CapitalPi] satisfies Jacobi", allZeroQ[jacobiator[\[CapitalPi]LP, m]]];
check["4b  {m_i, m_j} = \[Epsilon]_ijk m_k  (so(3) structure constants)", Outer[lp, m, m] === \[CapitalPi]LP];
check["4c  {f,g} = m\[CenterDot](\[Del]f\[Times]\[Del]g)", zeroQ[lp[f @@ m, g @@ m] - m . Cross[grad[f @@ m, m], grad[g @@ m, m]]]];
check["4d  C = |m|^2 is a Casimir", zeroQ[lp[m . m, f @@ m]]];
check["4e  any function of |m|^2 is a Casimir", zeroQ[lp[\[CurlyPhi][m . m], f @@ m]]];

Hrb = Sum[m[[i]]^2/(2 Iner[i]), {i, 3}];
mdot = -lp[#, Hrb] & /@ m; (* minus bracket *)
euler = {(Iner[2] - Iner[3]) m2 m3/(Iner[2] Iner[3]), (Iner[3] - Iner[1]) m3 m1/(Iner[3] Iner[1]), (Iner[1] - Iner[2]) m1 m2/(Iner[1] Iner[2])};
check["4f  rigid body: m' = {m,H}_- is Euler's equations", allZeroQ[mdot - euler]];
check["4g  rigid body conserves H and |m|^2", zeroQ[mdot . grad[Hrb, m]] && zeroQ[mdot . grad[m . m, m]]];


(* ::Section:: *)
(*5. Where it is used: mechanics, symmetry, numerical integration, field theory*)

(* ::Text:: *)
(* Kepler problem H = |p|^2/2 - 1/|q| in R^3.  Angular momentum L = q\[Times]p and the*)
(* Laplace\[Dash]Runge\[Dash]Lenz vector A = p\[Times]L - q/|q| are conserved.  Their brackets close:*)
(*   {L_i,L_j} = \[Epsilon] L_k,  {L_i,A_j} = \[Epsilon] A_k,  {A_i,A_j} = -2H \[Epsilon] L_k*)
(* \[LongDash] so(4) on bound orbits (H < 0).  This hidden symmetry is why orbits close and why*)
(* the hydrogen spectrum is degenerate (Pauli 1926).*)

q3 = {x1, x2, x3}; p3 = {y1, y2, y3};
pb3[f_, g_] := PBq[f, g, q3, p3];
rr = Sqrt[q3 . q3];
Hk = p3 . p3/2 - 1/rr;
L = Cross[q3, p3]; A = Cross[p3, L] - q3/rr;
epsT[V_] := Table[Sum[\[Epsilon][[i, j, kk]] V[[kk]], {kk, 3}], {i, 3}, {j, 3}];
check["5a  Kepler: {L_i,H} = 0", allZeroQ[pb3[#, Hk] & /@ L]];
check["5b  Kepler: {A_i,H} = 0 (Runge\[Dash]Lenz)", allZeroQ[pb3[#, Hk] & /@ A]];
check["5c  {L_i,L_j} = \[Epsilon]_ijk L_k", allZeroQ[Outer[pb3, L, L] - epsT[L]]];
check["5d  {L_i,A_j} = \[Epsilon]_ijk A_k", allZeroQ[Outer[pb3, L, A] - epsT[A]]];
check["5e  {A_i,A_j} = -2H \[Epsilon]_ijk L_k  (so(4) for H<0)", allZeroQ[Outer[pb3, A, A] + 2 Hk epsT[L]]];
check["5f  Poisson's theorem in action: {L1,L2} = L3 is again conserved", zeroQ[pb3[pb3[L[[1]], L[[2]]], Hk]]];

(* momentum map: L3 generates rotations about the q3-axis *)
check["5g  {f, L3} = (x1 \[PartialD]2 - x2 \[PartialD]1) f : L3 generates rotations",
  zeroQ[pb3[f @@ q3, L[[3]]] - (x1 D[f @@ q3, x2] - x2 D[f @@ q3, x1])]];

(* symplectic integrators: leapfrog step for the pendulum H = p^2/2 - cos q *)
leap[{q_, p_}, h_] := Module[{ph = p - h/2 Sin[q], qn}, qn = q + h ph; {qn, ph - h/2 Sin[qn]}];
eulerStep[{q_, p_}, h_] := {q + h p, p - h Sin[q]};
Msym = D[leap[{q, p}, h], {{q, p}}]; Meul = D[eulerStep[{q, p}, h], {{q, p}}];
check["5h  leapfrog is symplectic: M^T J M = J", allZeroQ[Transpose[Msym] . Jcan[1] . Msym - Jcan[1]]];
check["5i  explicit Euler is not: det M = 1 + h^2 cos q", zeroQ[Det[Meul] - (1 + h^2 Cos[q])]];

(* infinite dimensions: KdV as a Hamiltonian PDE with the Gardner bracket {F,G} = \[Integral] \[Delta]F/\[Delta]u \[PartialD]x \[Delta]G/\[Delta]u dx *)
(* Euler operator E(e) = \[Sum]_k (-\[PartialD]s)^k \[PartialD]e/\[PartialD]u^(k)  = variational derivative \[Delta]/\[Delta]u *)
eulerOp[e_] := Expand@Sum[(-1)^kk D[D[e, Derivative[kk][u][s]], {s, kk}], {kk, 0, 6}];
dens = u[s]^3 + D[u[s], s]^2/2;
\[Delta]H = eulerOp[dens];
kdvRHS = D[\[Delta]H, s];
check["5j  u_t = {u, H} is KdV: u_t = 6 u u_x - u_xxx",
  zeroQ[kdvRHS - (6 u[s] D[u[s], s] - D[u[s], {s, 3}])]];
(* an integrand is a total derivative iff its Euler operator vanishes *)
totalDerivativeQ[e_] := zeroQ[eulerOp[e]];
check["5k  KdV conserves mass \[Integral]u, momentum \[Integral]u^2/2 and energy H",
  totalDerivativeQ[1 kdvRHS] && totalDerivativeQ[u[s] kdvRHS] && totalDerivativeQ[\[Delta]H kdvRHS] &&
   ! totalDerivativeQ[u[s]^2 D[u[s], {s, 2}]]];


(* ::Section:: *)
(*6. Geometry and manifolds*)

(* ::Text:: *)
(* Symplectic manifold (M, \[Omega]):  \[Omega](X_f, \[CenterDot]) = -df  and  {f,g} = \[Omega](X_g, X_f) (convention-*)
(* dependent sign); in coordinates \[CapitalPi] = \[Omega]^{-1} up to sign.  Facts checked:*)
(*  \[Bullet] Liouville: Hamiltonian vector fields are divergence-free (phase volume kept);*)
(*  \[Bullet] Darboux: locally {q_i,p_j} = \[Delta]_ij \[LongDash] on the sphere (\[Phi], z) are Darboux*)
(*    coordinates (Archimedes: area = 2\[Pi] R \[Times] height);*)
(*  \[Bullet] the leaf |m| = R of so(3)* carries \[Omega] = area/R (Kirillov\[Dash]Kostant\[Dash]Souriau);*)
(*  \[Bullet] cotangent bundles: H = \[OneHalf] g^{ij} p_i p_j generates the geodesic flow;*)
(*  \[Bullet] action\[Dash]angle variables and integrability (functions in involution).*)

(* Liouville *)
XH = Join[D[Hg, {ps}], -D[Hg, {qs}]];
check["6a  Liouville: div X_H = 0 for every H", zeroQ[Total[MapThread[D, {XH, z4}]]]];

(* sphere leaf of so(3)*, radius R *)
sph = Thread[m -> R {Sin[\[Theta]] Cos[\[Phi]], Sin[\[Theta]] Sin[\[Phi]], Cos[\[Theta]]}];
\[Theta]m = ArcCos[m3/Sqrt[m . m]]; \[Phi]m = ArcTan[m1, m2];
asm = R > 0 && 0 < \[Theta] < Pi && -Pi < \[Phi] < Pi;
check["6b  Archimedes\[Dash]Darboux: {\[Phi], m3} = 1 on every sphere", Simplify[lp[\[Phi]m, m3] /. sph, asm] === 1];
\[Theta]\[Phi]bracket = Simplify[lp[\[Theta]m, \[Phi]m] /. sph, asm];
check["6c  {\[Theta],\[Phi]} = 1/(R sin\[Theta])", zeroQ[\[Theta]\[Phi]bracket - 1/(R Sin[\[Theta]])]];
\[Omega]\[Theta]\[Phi] = -Inverse[{{0, \[Theta]\[Phi]bracket}, {-\[Theta]\[Phi]bracket, 0}}][[1, 2]];
check["6d  KKS form \[Omega] = (area form R^2 sin\[Theta] d\[Theta]\[Wedge]d\[Phi]) / R", Simplify[\[Omega]\[Theta]\[Phi] - R^2 Sin[\[Theta]]/R, asm] === 0];
check["6e  total symplectic area of the leaf = 4\[Pi]R",
  Integrate[\[Omega]\[Theta]\[Phi], {\[Theta], 0, Pi}, {\[Phi], -Pi, Pi}, Assumptions -> R > 0] === 4 Pi R];
(* integrality 4\[Pi]R \[Element] 2\[Pi]\[HBar] Z is the semiclassical spin condition R = \[HBar] j *)

(* action\[Dash]angle for the oscillator *)
Iact = (q^2 + p^2)/2; \[Theta]ang = ArcTan[p, q];
check["6f  action\[Dash]angle: {\[Theta], I} = 1 and H = I, so \[Theta]' = 1", zeroQ[pb1[\[Theta]ang, Iact] - 1] && zeroQ[pb1[\[Theta]ang, Hosc] - 1]];
(* Liouville\[Dash]Arnold integrability: n functions in involution *)
H1 = (p1^2 + \[Omega]1^2 q1^2)/2; H2 = (p2^2 + \[Omega]2^2 q2^2)/2;
check["6g  anisotropic oscillator: {H1,H2} = 0 (integrable)", zeroQ[pb[H1, H2]]];

(* geodesic flow on T*M *)
christoffel[gm_, v_] := With[{gi = Inverse[gm], n = Length[v]},
   Table[Simplify@Sum[gi[[kk, l]] (D[gm[[l, i]], v[[j]]] + D[gm[[l, j]], v[[i]]] - D[gm[[i, j]], v[[l]]])/2, {l, n}], {kk, n}, {i, n}, {j, n}]];
geodesicCheck[gm_, v_, pv_] := Module[{Hgeo, vel, acc, c = christoffel[gm, v], n = Length[v]},
   Hgeo = pv . Inverse[gm] . pv/2;
   vel = PBq[#, Hgeo, v, pv] & /@ v;
   acc = PBq[#, Hgeo, v, pv] & /@ vel;
   allZeroQ[acc + Table[Sum[c[[kk, i, j]] vel[[i]] vel[[j]], {i, n}, {j, n}], {kk, n}]]];
check["6h  S^2: H = \[OneHalf]g^{ij}p_ip_j generates geodesics q'' + \[CapitalGamma]q'q' = 0",
  geodesicCheck[{{1, 0}, {0, Sin[\[Theta]]^2}}, {\[Theta], \[Phi]}, {p\[Theta], p\[Phi]}]];
check["6i  hyperbolic plane: same", geodesicCheck[{{1/y^2, 0}, {0, 1/y^2}}, {x, y}, {px, py}]];
check["6j  arbitrary conformal surface: same", geodesicCheck[Exp[2 w[x, y]] IdentityMatrix[2], {x, y}, {px, py}]];
check["6k  Clairaut: p\[Phi] is conserved on the sphere (rotation symmetry)",
  zeroQ[PBq[p\[Phi], (p\[Theta]^2 + p\[Phi]^2/Sin[\[Theta]]^2)/2, {\[Theta], \[Phi]}, {p\[Theta], p\[Phi]}]]];

(* link back to Laplacian brackets: on C, \[CapitalGamma] + i{ , } = 4 \[PartialD]z f \[PartialD]zbar g *)
dz[e_] := (D[e, x] - I D[e, y])/2; dzb[e_] := (D[e, x] + I D[e, y])/2;
\[CapitalGamma]2d[f_, g_] := D[f, x] D[g, x] + D[f, y] D[g, y];
check["6l  K\[ADoubleDot]hler link: {f,g} = Im(4 \[PartialD]z f \[PartialD]zbar g), \[CapitalGamma] = Re(...)",
  zeroQ[\[CapitalGamma]2d[f[x, y], g[x, y]] + I PBq[f[x, y], g[x, y], {x}, {y}] - 4 dz[f[x, y]] dzb[g[x, y]]]];


(* ::Section:: *)
(*Report*)

Dataset[checks]
